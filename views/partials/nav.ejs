                </svg>
                Host Homes
              </a>
            </li>

            <li>
              <a
                href="/add-home"
                class="text-gray-800 hover:bg-gray-100 py-2 px-4 rounded-lg transition duration-200 font-medium flex items-center"
              >
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 mr-1">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v6m3-3H9m12 0a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                Add Home
              </a>
            </li>
          <% } %>
        <%}%>
      </ul>
    </div>
    
    <!-- Right side: User menu or auth links -->
    <div class="flex items-center">
      <% if(!isLoggedIn) { %>
        <div class="flex items-center space-x-2">
          <a
            href="/signup"
            class="text-gray-800 hover:bg-gray-100 py-2 px-4 rounded-lg transition duration-200 font-medium flex items-center"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 mr-1">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" />
            </svg>
            Sign Up
          </a>
          <a
            href="/login"
            class="text-gray-800 hover:bg-gray-100 py-2 px-4 rounded-lg transition duration-200 font-medium flex items-center"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 mr-1">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9m-7.5 0m0-4.5v4.5m0 0v4.5m0-4.5h7.5m-7.5 0h-2.25" />
            </svg>
            Log in
          </a>
        </div>
      <% } else {%>
        <div class="flex items-center space-x-3">
          <div class="relative">
            <button id="user-menu-button" class="flex items-center text-sm rounded-full focus:outline-none" aria-haspopup="true" aria-expanded="false">
              <div class="w-8 h-8 rounded-full bg-rose-100 flex items-center justify-center text-rose-700 font-semibold">
                <%= (user.firstName || user.name || 'U').charAt(0).toUpperCase() %>
              </div>
            </button>
            
            <!-- Dropdown menu -->
            <div id="user-dropdown" class="hidden absolute right-0 mt-2 w-48 bg-white rounded-md shadow-lg py-1 z-50 border border-gray-200" role="menu">
              <div class="px-4 py-2 border-b border-gray-100">
                <p class="text-sm font-medium text-gray-900"><%= (user.firstName || user.name || 'User') + ' ' + (user.lastName || '') %></p>
                <p class="text-xs text-gray-500 truncate"><%= user.email %></p>
              </div>
              <form action="/logout" method="post" class="block w-full text-left">
                <button 
                  type="submit"
                  class="block w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 transition duration-150"
                  role="menuitem"
                >
                  Sign out
                </button>
              </form>
            </div>
          </div>
        </div>
      <% } %>
    </div>
  </nav>
  
  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden md:hidden bg-white border-t border-gray-100 py-2 px-4">
    <ul class="space-y-2">
      <% if(isLoggedIn) { %>
        <% if(user && user.userType=="guest") {%>
          <li>
            <a href="/home" class="block py-2 px-4 rounded-lg text-gray-800 hover:bg-gray-100 transition duration-200">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 inline mr-2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 21v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21m0 0h4.125c.621 0 1.125-.504 1.125-1.125V9.75c0-6.21-5.04-11.25-11.25-11.25S2.25 3.54 2.25 9.75v10.125c0 .621.504 1.125 1.125 1.125H6.75zm8.97-7.125h-3.9v-3.9h3.9v3.9z" />
              </svg>
              Homes
            </a>
          </li>
          <li>
            <a href="/favourites" class="block py-2 px-4 rounded-lg text-gray-800 hover:bg-gray-100 transition duration-200">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 inline mr-2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
              </svg>
              Favourites
            </a>
          </li>
          <li>
            <a href="/booking" class="block py-2 px-4 rounded-lg text-gray-800 hover:bg-gray-100 transition duration-200">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 inline mr-2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              Bookings
            </a>
          </li>
        <%} else {%>
          <li>
            <a href="/host-home-list" class="block py-2 px-4 rounded-lg text-gray-800 hover:bg-gray-100 transition duration-200">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 inline mr-2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-.75.75H7.5A2.25 2.25 0 015.25 9v6a2.25 2.25 0 002.25 2.25h6a2.25 2.25 0 002.25-2.25V9a2.25 2.25 0 00-.75-.75H13.5A2.25 2.25 0 0112 7.5V6a2.25 2.25 0 012.25-2.25H16.5A2.25 2.25 0 0118.75 6v2.25A2.25 2.25 0 0118 9H16.5a.75.75 0 00-.75.75v6a.75.75 0 00.75.75h2.25a.75.75 0 00.75-.75V9a.75.75 0 00-.75-.75H18a2.25 2.25 0 00-2.25-2.25H13.5A2.25 2.25 0 0011.25 9v6a2.25 2.25 0 002.25 2.25h6a2.25 2.25 0 002.25-2.25V6a2.25 2.25 0 00-2.25-2.25H19.5A.75.75 0 0018.75 3H7.5A.75.75 0 006.75 3.75z" />
              </svg>
              Host Homes
            </a>
          </li>
          <li>
            <a href="/add-home" class="block py-2 px-4 rounded-lg text-gray-800 hover:bg-gray-100 transition duration-200">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 inline mr-2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v6m3-3H9m12 0a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              Add Home
            </a>
          </li>
        <% } %>
      <%}%>
      
      <% if(!isLoggedIn) { %>
        <li>
          <a href="/signup" class="block py-2 px-4 rounded-lg text-gray-800 hover:bg-gray-100 transition duration-200">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 inline mr-2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" />
            </svg>
            Sign Up
          </a>
        </li>
        <li>
          <a href="/login" class="block py-2 px-4 rounded-lg text-gray-800 hover:bg-gray-100 transition duration-200">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 inline mr-2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9m-7.5 0m0-4.5v4.5m0 0v4.5m0-4.5h7.5m-7.5 0h-2.25" />
            </svg>
            Log in
          </a>
        </li>
      <% } else {%>
        <li>
          <div class="px-4 py-2 border-b border-gray-100">
            <p class="text-sm font-medium text-gray-900"><%= (user.firstName || user.name || 'User') + ' ' + (user.lastName || '') %></p>
            <p class="text-xs text-gray-500 truncate"><%= user.email %></p>
          </div>
        </li>
        <li>
          <form action="/logout" method="post" class="block w-full text-left">
            <button 
              type="submit"
              class="block w-full text-left py-2 px-4 rounded-lg text-gray-800 hover:bg-gray-100 transition duration-200"
